# Local Postgres started by docker compose. Change the password in both
# this file and docker-compose.yml if the machine is shared.
DATABASE_URL=postgresql://zoogi:zoogi@127.0.0.1:5432/zoogiroll

# Signs the login cookie. Use a long random string on your machine.
SESSION_SECRET=change-me-to-a-long-random-string

# The game listens here. Open http://127.0.0.1:5000
PORT=5000
HOST=127.0.0.1

# Phone on the same Wi-Fi: run `npm run dev:lan` (or set HOST=0.0.0.0).
# That prints http://192.168.x.x:5000. Leave HOST as 127.0.0.1 for this PC only.

# Optional. When set, visitors must enter this password before the game loads.
# Leave it unset at home. Set it in the host dashboard for a public link.
# Do not commit the real password.
# PLAY_PASSWORD=

# Optional. Leave blank unless you use Create Zoogi or Create Arena.
MESHY_API_KEY=
